{
  "name": "immotulear-backend",
  "version": "1.0.0",
  "description": "Backend API pour ImmoTulear - Agence immobiliere a Toliara, Madagascar",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/init-db.js",
    "db:seed": "node src/seed.js",
    "db:reset": "node src/init-db.js && node src/seed.js",
    "admin:create": "node createAdmin.js",
    "env:init": "node scripts/env.js init",
    "env:check": "node scripts/env.js check",
    "env:secret": "node scripts/env.js secret",
    "mail:test": "node scripts/mail-test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^10.0.16",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
