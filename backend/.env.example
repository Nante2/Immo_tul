# =============================================================
#  Configuration du backend ImmoTuléar
#  Copiez ce fichier en .env (ou lancez : npm run env:init)
#  Ne commitez jamais le fichier .env : il contient des secrets.
# =============================================================

# Environnement : development ou production
# En production, une configuration invalide empêche le démarrage.
NODE_ENV=development

# --- Serveur ---
PORT=3001
# Adresse du site (frontend) autorisée à appeler l'API (CORS)
FRONTEND_URL=http://localhost:5173

# --- Base de données PostgreSQL ---
# Format : postgresql://utilisateur:motdepasse@hote:port/nom_de_la_base
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/immo_tul

# --- Authentification ---
# Secret de signature des sessions : au moins 32 caractères aléatoires.
# Le changer déconnecte tous les utilisateurs (npm run env:secret).
JWT_SECRET=votre_secret_jwt_tres_securise
# Durée d'une session avant reconnexion (ex: 12h, 7d)
JWT_EXPIRES_IN=7d

# --- Fichiers envoyés (photos des biens) ---
UPLOAD_DIR=uploads

# --- Premier compte administrateur (npm run admin:create) ---
ADMIN_EMAIL=admin@immotulear.mg
ADMIN_PASSWORD=changez_moi
ADMIN_ROLE=admin

# --- Emails (notifications des messages du site) ---
# Laissez SMTP_HOST vide en développement : les emails s'affichent alors
# dans le terminal au lieu d'être envoyés.
# Exemples : Gmail -> smtp.gmail.com, port 587, mot de passe d'application
#            Brevo -> smtp-relay.brevo.com, port 587
SMTP_HOST=
SMTP_PORT=587
# true uniquement pour le port 465 (SSL direct)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché (souvent identique à SMTP_USER chez Gmail)
MAIL_FROM=ImmoTuléar <info@immotulear.mg>
# Qui reçoit les notifications de nouveaux messages (séparer par des virgules)
MAIL_TO=info@immotulear.mg
